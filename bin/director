#!/usr/bin/env python3
"""director — hotkey-driven screen recording for sway, with OBS as the engine.

OBS Studio does the capturing and encoding; director is the thin client that
hotkeys and waybar call, the way `dictator` is the client for `dictatord`.
OBS stays running (minimized to the tray) between recordings, so after the
first launch a hotkey press is recording within about a second.

    hotkey ──▶ director toggle screen ──┐
    waybar ◀── director watch ◀─────────┼─▶ obs-websocket (ws://127.0.0.1:4455) ─▶ OBS
                                        │     scene "screen" = Screen Capture (PipeWire)
                                        │     scene "pip"    = screen + Camera picture-in-picture
                                        │     Mic/Aux on, Desktop Audio present but muted
                                        └──▶ launches `obs --minimize-to-tray` on demand

Layouts are OBS scenes in the "director" scene collection: `director setup`
writes a starter collection (screen, pip) and a "director" profile (mkv into
~/Videos, 30 fps, x264, output scaled to 1080p); edit them in the OBS GUI
(tray icon -> show) and they stick. Any scene you add is usable as
`director toggle <scene>`.

What is captured is decided by the portal picker (slurp) the first time OBS
starts: click the output to share (xdg-desktop-portal-wlr shares whole
outputs; it has no region or window capture). xdpw hands OBS a restore token,
so later launches restore the choice silently. `--repick` (or `director
repick`) brings the picker back, e.g. after plugging in a second monitor.

OBS config lives in ~/.config/obs-studio (OBS's own logs: logs/). director
reads the obs-websocket port/password from global.ini; nothing else is stored.

Environment: DIRECTOR_SCENE (default scene, "screen"), DIRECTOR_VIDEOS_DIR
(~/Videos), DIRECTOR_COLLECTION / DIRECTOR_PROFILE ("director"),
DIRECTOR_OBS_PORT / DIRECTOR_OBS_PASSWORD (override global.ini),
DIRECTOR_OBS_ARGS (extra args for the obs launch).
"""

import argparse
import base64
import contextlib
import fcntl
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import socket
import struct
import subprocess
import sys
import time
import uuid
from pathlib import Path

PROG = "director"

USAGE = f"""usage: {PROG} [--notify] <command> [args]

commands:
  toggle [--repick] [--name N] [SCENE]   start recording, or stop if already recording
  start  [--repick] [--name N] [SCENE]   SCENE is an OBS scene (default: screen)
  stop                                   stop recording; prints the saved file
  pause                                  pause / resume the running recording
  scene SCENE                            switch layout, live (also while recording)
  status [--json]                        recording | paused | starting | stopping | idle | down
  watch  [--format plain|json|waybar]    stream state changes (waybar custom module)
  scenes                                 list the layouts (OBS scenes); * = current
  repick                                 re-select which output "Screen" captures (slurp)
  obs                                    make sure OBS is running and capturing
  quit                                   stop recording and exit OBS
  setup [--force]                        write the OBS profile + scene collection, enable obs-websocket

flags:
  --notify       on failure, also raise a desktop notification (for hotkeys);
                 `stop`/`toggle` also notify where the recording was saved
  --repick       bring the portal picker (slurp) back before recording
  --name N       file name prefix for this recording (default "rec"):
                 ~/Videos/N-YYYY-MM-DD-hhmmss.mkv
"""

# --- configuration -----------------------------------------------------------

HOME = Path.home()
OBS_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "obs-studio"
COLLECTION = os.environ.get("DIRECTOR_COLLECTION", "director")
PROFILE = os.environ.get("DIRECTOR_PROFILE", "director")
DEFAULT_SCENE = os.environ.get("DIRECTOR_SCENE", "screen")
VIDEOS_DIR = Path(os.environ.get("DIRECTOR_VIDEOS_DIR", HOME / "Videos")).expanduser()
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/{PROG}-{os.getuid()}")
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / PROG
LOCK_PATH = RUNTIME_DIR / f"{PROG}.lock"

SCREEN_INPUT = "Screen"
CAMERA_INPUT = "Camera"
PIPEWIRE_KIND = "pipewire-desktop-capture-source"  # "Screen Capture (PipeWire)" in OBS 30
PIPEWIRE_REPICK_BUTTON = "Reload"  # the source's "Select Monitor" properties button
TIMESTAMP_FORMAT = "%CCYY-%MM-%DD-%hh%mm%ss"  # OBS filename-formatting specifiers
DEFAULT_NAME = "rec"

# obs-websocket 5 event subscription bits
EV_GENERAL, EV_SCENES, EV_OUTPUTS = 1 << 0, 1 << 2, 1 << 6

LAUNCH_TIMEOUT = 45.0  # OBS cold start until obs-websocket answers
PICKER_TIMEOUT = 180.0  # the human has to click something in the picker
RECORD_TIMEOUT = 10.0  # StartRecord/StopRecord until the output flips state

ACTIVE_STATES = ("recording", "paused")


class Fail(Exception):
    """A user-facing failure: printed as `director: <msg>`, exit 1."""


class OBSDown(Fail):
    """OBS (or its websocket server) is not reachable."""


# --- a minimal RFC 6455 client (text frames only; enough for obs-websocket) --

class WebSocket:
    GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

    def __init__(self, sock):
        self.sock = sock
        self.buf = bytearray()
        self.frag = bytearray()

    @classmethod
    def connect(cls, host, port, timeout, subprotocol):
        sock = socket.create_connection((host, port), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        request = (
            f"GET / HTTP/1.1\r\nHost: {host}:{port}\r\n"
            "Upgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
            f"Sec-WebSocket-Protocol: {subprotocol}\r\n\r\n"
        )
        sock.sendall(request.encode())
        ws = cls(sock)
        head = ws._read_until(b"\r\n\r\n", timeout)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101 " not in status:
            sock.close()
            raise ConnectionError(f"websocket handshake refused: {status}")
        expect = base64.b64encode(hashlib.sha1((key + cls.GUID).encode()).digest()).decode()
        if f"Sec-WebSocket-Accept: {expect}".encode().lower() not in head.lower():
            sock.close()
            raise ConnectionError("websocket handshake: bad Sec-WebSocket-Accept")
        return ws

    def _read_until(self, marker, timeout):
        deadline = time.monotonic() + timeout
        while marker not in self.buf:
            self._fill(deadline - time.monotonic())
        i = self.buf.index(marker) + len(marker)
        head, self.buf = bytes(self.buf[:i]), self.buf[i:]
        return head

    def _fill(self, remaining):
        if remaining is not None and remaining <= 0:
            raise socket.timeout()
        self.sock.settimeout(remaining)
        chunk = self.sock.recv(65536)
        if not chunk:
            raise ConnectionError("connection closed")
        self.buf += chunk

    def _send(self, opcode, payload):
        header = bytearray([0x80 | opcode])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        key = os.urandom(4)
        header += key
        mask = (key * (n // 4 + 1))[:n]
        masked = int.from_bytes(payload, "big") ^ int.from_bytes(mask, "big") if n else 0
        self.sock.sendall(bytes(header) + masked.to_bytes(n, "big"))

    def send_text(self, text):
        self._send(0x1, text.encode())

    def _parse_frame(self):
        b = self.buf
        if len(b) < 2:
            return None
        fin, opcode = b[0] & 0x80, b[0] & 0x0F
        masked, length = b[1] & 0x80, b[1] & 0x7F
        i = 2
        if length == 126:
            if len(b) < 4:
                return None
            (length,) = struct.unpack(">H", b[2:4])
            i = 4
        elif length == 127:
            if len(b) < 10:
                return None
            (length,) = struct.unpack(">Q", b[2:10])
            i = 10
        key = None
        if masked:
            if len(b) < i + 4:
                return None
            key = bytes(b[i:i + 4])
            i += 4
        if len(b) < i + length:
            return None
        payload = bytes(b[i:i + length])
        if key:
            payload = bytes(c ^ key[j % 4] for j, c in enumerate(payload))
        del self.buf[:i + length]
        return opcode, payload, bool(fin)

    def recv_text(self, timeout):
        """Next text message, or None when `timeout` seconds pass without one."""
        deadline = None if timeout is None else time.monotonic() + timeout
        while True:
            frame = self._parse_frame()
            if frame is None:
                try:
                    self._fill(None if deadline is None else deadline - time.monotonic())
                except socket.timeout:
                    return None
                continue
            opcode, payload, fin = frame
            if opcode in (0x1, 0x0):
                self.frag += payload
                if fin:
                    text = self.frag.decode()
                    self.frag = bytearray()
                    return text
            elif opcode == 0x8:
                code = struct.unpack(">H", payload[:2])[0] if len(payload) >= 2 else 1005
                reason = payload[2:].decode(errors="replace")
                raise ConnectionError(f"closed by server ({code}) {reason}".rstrip())
            elif opcode == 0x9:
                self._send(0xA, payload)

    def close(self):
        # Send Close, then give the server a moment to answer so it logs a
        # clean 1000 instead of an abnormal 1006 for every hotkey press.
        with contextlib.suppress(OSError, ConnectionError, ValueError):
            self._send(0x8, struct.pack(">H", 1000))
            self.recv_text(0.3)
        with contextlib.suppress(OSError):
            self.sock.close()


# --- obs-websocket v5 --------------------------------------------------------

class OBSRequestError(Fail):
    def __init__(self, request_type, code, comment):
        super().__init__(f"{request_type} failed ({code}): {comment or 'no details'}")
        self.code = code


class OBS:
    """One obs-websocket connection: synchronous requests plus an event queue."""

    def __init__(self, ws):
        self.ws = ws
        self.pending_events = []
        self.next_id = 0

    @classmethod
    def connect(cls, events=0, timeout=2.0):
        host, port, password = websocket_config()
        try:
            ws = WebSocket.connect(host, port, timeout, "obswebsocket.json")
        except (OSError, ConnectionError) as e:
            raise OBSDown(f"OBS is not running (obs-websocket at {host}:{port}: {e})") from e
        try:
            hello = json.loads(ws.recv_text(timeout) or "null")
            if not hello or hello.get("op") != 0:
                raise Fail("no Hello from obs-websocket")
            identify = {"rpcVersion": 1, "eventSubscriptions": events}
            auth = hello["d"].get("authentication")
            if auth:
                if not password:
                    raise Fail("obs-websocket wants a password but none is set; run `director setup`")
                secret = base64.b64encode(hashlib.sha256((password + auth["salt"]).encode()).digest()).decode()
                identify["authentication"] = base64.b64encode(
                    hashlib.sha256((secret + auth["challenge"]).encode()).digest()).decode()
            ws.send_text(json.dumps({"op": 1, "d": identify}))
            try:
                identified = json.loads(ws.recv_text(timeout) or "null")
            except ConnectionError as e:
                if "4009" in str(e):
                    raise Fail("obs-websocket rejected the password; check [OBSWebSocket] in "
                               f"{OBS_DIR / 'global.ini'} or set DIRECTOR_OBS_PASSWORD") from e
                raise
            if not identified or identified.get("op") != 2:
                raise Fail(f"obs-websocket did not identify us: {identified}")
        except Exception:
            ws.close()
            raise
        return cls(ws)

    def request(self, request_type, data=None, timeout=10.0):
        self.next_id += 1
        rid = str(self.next_id)
        msg = {"op": 6, "d": {"requestType": request_type, "requestId": rid}}
        if data:
            msg["d"]["requestData"] = data
        self.ws.send_text(json.dumps(msg))
        deadline = time.monotonic() + timeout
        while True:
            text = self.ws.recv_text(deadline - time.monotonic())
            if text is None:
                raise Fail(f"{request_type}: no reply from OBS within {timeout:.0f}s")
            m = json.loads(text)
            if m.get("op") == 5:
                self.pending_events.append(m["d"])
            elif m.get("op") == 7 and m["d"].get("requestId") == rid:
                status = m["d"]["requestStatus"]
                if not status.get("result"):
                    raise OBSRequestError(request_type, status.get("code"), status.get("comment"))
                return m["d"].get("responseData") or {}

    def next_event(self, timeout):
        """(eventType, eventData) or None on timeout. Needs an event subscription."""
        if self.pending_events:
            ev = self.pending_events.pop(0)
            return ev["eventType"], ev.get("eventData") or {}
        deadline = time.monotonic() + timeout
        while True:
            text = self.ws.recv_text(deadline - time.monotonic())
            if text is None:
                return None
            m = json.loads(text)
            if m.get("op") == 5:
                return m["d"]["eventType"], m["d"].get("eventData") or {}

    def close(self):
        self.ws.close()


def websocket_config():
    host = os.environ.get("DIRECTOR_OBS_HOST", "127.0.0.1")
    lines = ini_lines(OBS_DIR / "global.ini")
    port = os.environ.get("DIRECTOR_OBS_PORT") or ini_get(lines, "OBSWebSocket", "ServerPort") or "4455"
    password = os.environ.get("DIRECTOR_OBS_PASSWORD")
    if password is None:
        password = ini_get(lines, "OBSWebSocket", "ServerPassword") or ""
    return host, int(port), password


# --- OBS's ini files (global.ini, basic.ini): keep them byte-for-byte --------

def ini_lines(path):
    try:
        return path.read_text().split("\n")
    except FileNotFoundError:
        return []


def ini_get(lines, section, key):
    current = None
    for line in lines:
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            current = s[1:-1]
        elif current == section and "=" in s:
            k, _, v = s.partition("=")
            if k == key:
                return v
    return None


def ini_set(lines, section, key, value):
    """Set key=value inside [section], editing in place; returns True if changed."""
    current, start, end = None, None, None
    for i, line in enumerate(lines):
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if current == section:
                end = i
                break
            current = s[1:-1]
            if current == section:
                start = i
        elif current == section and s.partition("=")[0] == key:
            if s.partition("=")[2] == value:
                return False
            lines[i] = f"{key}={value}"
            return True
    if start is None:
        while lines and lines[-1] == "":
            lines.pop()
        lines.extend(["", f"[{section}]", f"{key}={value}", ""])
        return True
    insert_at = len(lines) if end is None else end
    while insert_at > start + 1 and lines[insert_at - 1] == "":
        insert_at -= 1
    lines.insert(insert_at, f"{key}={value}")
    return True


# --- setup: profile, scene collection, websocket server ----------------------

def obs_pids():
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), "obs"], capture_output=True, text=True)
    return [int(p) for p in r.stdout.split()] if r.returncode == 0 else []


def output_mode():
    """Physical size of the active sway output (the OBS canvas), or 1080p."""
    try:
        outputs = json.loads(subprocess.run(["swaymsg", "-t", "get_outputs"], capture_output=True,
                                            text=True, check=True, timeout=5).stdout)
        for out in outputs:
            mode = out.get("current_mode")
            if out.get("active") and mode:
                return int(mode["width"]), int(mode["height"])
    except (OSError, ValueError, subprocess.SubprocessError, KeyError):
        pass
    return 1920, 1080


def detect_camera():
    cams = sorted(glob.glob("/dev/v4l/by-id/*-video-index0"))
    return cams[0] if cams else ""


def build_profile(base_w, base_h):
    out_h = min(base_h, 1080)
    out_w = round(base_w * out_h / base_h / 2) * 2
    return f"""[General]
Name={PROFILE}

[Video]
BaseCX={base_w}
BaseCY={base_h}
OutputCX={out_w}
OutputCY={out_h}
FPSType=0
FPSCommon=30
ScaleType=lanczos

[Audio]
SampleRate=48000
ChannelSetup=Stereo

[Output]
Mode=Simple
FilenameFormatting={DEFAULT_NAME}-{TIMESTAMP_FORMAT}

[SimpleOutput]
FilePath={VIDEOS_DIR}
RecFormat2=mkv
RecQuality=Small
RecEncoder=x264
RecAudioEncoder=aac
RecTracks=1
"""


def build_collection(base_w, base_h, camera_device):
    prev_ver = (30 << 24) | (0 << 16) | 2  # libobs 30.0.2, the version this layout was written for

    def source(name, kind, settings, uid, mixers=0, hotkeys=None, muted=False):
        return {
            "prev_ver": prev_ver, "name": name, "uuid": uid, "id": kind, "versioned_id": kind,
            "settings": settings, "mixers": mixers, "sync": 0, "flags": 0, "volume": 1.0,
            "balance": 0.5, "enabled": True, "muted": muted, "push-to-mute": False,
            "push-to-mute-delay": 0, "push-to-talk": False, "push-to-talk-delay": 0,
            "hotkeys": hotkeys or {}, "deinterlace_mode": 0, "deinterlace_field_order": 0,
            "monitoring_type": 0, "private_settings": {},
        }

    def audio(name, kind, muted):
        hotkeys = {k: [] for k in ("libobs.mute", "libobs.unmute", "libobs.push-to-mute", "libobs.push-to-talk")}
        return source(name, kind, {"device_id": "default"}, str(uuid.uuid4()), mixers=255,
                      hotkeys=hotkeys, muted=muted)

    def item(item_id, name, uid, pos, bounds, scale_filter="disable"):
        # bounds_type 2 = OBS_BOUNDS_SCALE_INNER: fit inside `bounds` keeping aspect,
        # so a differently-sized output or a 4:3 camera still lands where expected.
        return {
            "name": name, "source_uuid": uid, "visible": True, "locked": False, "rot": 0.0,
            "pos": {"x": float(pos[0]), "y": float(pos[1])}, "scale": {"x": 1.0, "y": 1.0},
            "align": 5, "bounds_type": 2, "bounds_align": 0,
            "bounds": {"x": float(bounds[0]), "y": float(bounds[1])},
            "crop_left": 0, "crop_top": 0, "crop_right": 0, "crop_bottom": 0, "id": item_id,
            "group_item_backup": False, "scale_filter": scale_filter, "blend_method": "default",
            "blend_type": "normal", "show_transition": {"duration": 0},
            "hide_transition": {"duration": 0}, "private_settings": {},
        }

    def scene(name, items):
        hotkeys = {"OBSBasic.SelectScene": []}
        for it in items:
            hotkeys[f"libobs.show_scene_item.{it['id']}"] = []
            hotkeys[f"libobs.hide_scene_item.{it['id']}"] = []
        return source(name, "scene", {"id_counter": len(items), "custom_size": False, "items": items},
                      str(uuid.uuid4()), hotkeys=hotkeys)

    screen_uid, camera_uid = str(uuid.uuid4()), str(uuid.uuid4())
    pip_w, pip_h, margin = base_w // 4, base_h // 4, base_w // 80
    screen_item = item(1, SCREEN_INPUT, screen_uid, (0, 0), (base_w, base_h))
    camera_item = item(2, CAMERA_INPUT, camera_uid,
                       (base_w - pip_w - margin, base_h - pip_h - margin), (pip_w, pip_h),
                       scale_filter="lanczos")
    return {
        "DesktopAudioDevice1": audio("Desktop Audio", "pulse_output_capture", muted=True),
        "AuxAudioDevice1": audio("Mic/Aux", "pulse_input_capture", muted=False),
        "current_scene": "screen",
        "current_program_scene": "screen",
        "scene_order": [{"name": "screen"}, {"name": "pip"}],
        "name": COLLECTION,
        "sources": [
            scene("screen", [screen_item]),
            scene("pip", [screen_item, camera_item]),
            source(SCREEN_INPUT, PIPEWIRE_KIND, {"ShowCursor": True}, screen_uid),
            source(CAMERA_INPUT, "v4l2_input", {"device_id": camera_device}, camera_uid),
        ],
        "groups": [],
        "quick_transitions": [
            {"name": "Cut", "duration": 300, "hotkeys": [], "id": 1, "fade_to_black": False},
            {"name": "Fade", "duration": 300, "hotkeys": [], "id": 2, "fade_to_black": False},
            {"name": "Fade", "duration": 300, "hotkeys": [], "id": 3, "fade_to_black": True},
        ],
        "transitions": [],
        "saved_projectors": [],
        "current_transition": "Cut",
        "transition_duration": 300,
        "preview_locked": False,
        "scaling_enabled": False,
        "scaling_level": 0,
        "scaling_off_x": 0.0,
        "scaling_off_y": 0.0,
        "virtual-camera": {"type2": 3},
        "modules": {"scripts-tool": [], "auto-scene-switcher": {
            "interval": 300, "non_matching_scene": "", "switch_if_not_matching": False,
            "active": False, "switches": []}},
    }


def collection_path():
    return OBS_DIR / "basic" / "scenes" / f"{COLLECTION}.json"


def profile_path():
    return OBS_DIR / "basic" / "profiles" / PROFILE / "basic.ini"


def ensure_setup(force=False):
    """Idempotent. Returns the list of things it changed (empty = nothing to do)."""
    global_ini = OBS_DIR / "global.ini"
    lines = ini_lines(global_ini)
    fresh = not lines
    wanted = {"ServerEnabled": "true", "AuthRequired": "true",
              "ServerPort": ini_get(lines, "OBSWebSocket", "ServerPort") or "4455",
              "ServerPassword": ini_get(lines, "OBSWebSocket", "ServerPassword")
              or base64.b64encode(os.urandom(12)).decode()}
    ini_changes = any(ini_get(lines, "OBSWebSocket", k) != v for k, v in wanted.items())
    write_collection = force or not collection_path().exists()
    write_profile = force or not profile_path().exists()
    if not (ini_changes or write_collection or write_profile or fresh):
        VIDEOS_DIR.mkdir(parents=True, exist_ok=True)
        return []
    if obs_pids():
        raise Fail("OBS is running; it rewrites its config on exit, so quit it first "
                   "(`director quit`) and rerun")
    actions = []
    base_w, base_h = output_mode()
    VIDEOS_DIR.mkdir(parents=True, exist_ok=True)
    if write_collection:
        collection_path().parent.mkdir(parents=True, exist_ok=True)
        camera = detect_camera()
        collection_path().write_text(json.dumps(build_collection(base_w, base_h, camera), indent=4) + "\n")
        actions.append(f"wrote scene collection {collection_path()} (canvas {base_w}x{base_h}, "
                       f"camera {camera or 'none found'})")
    if write_profile:
        profile_path().parent.mkdir(parents=True, exist_ok=True)
        profile_path().write_text(build_profile(base_w, base_h))
        actions.append(f"wrote profile {profile_path()} (mkv -> {VIDEOS_DIR}, 30 fps, x264)")
    if fresh:
        # Never-run OBS: FirstRun=true is OBS's own "already ran" marker and
        # keeps the auto-configuration wizard from popping over the tray launch.
        lines = ["[General]", "FirstRun=true", ""]
    changed = [ini_set(lines, "OBSWebSocket", k, v) for k, v in wanted.items()]
    if any(changed) or fresh:
        OBS_DIR.mkdir(parents=True, exist_ok=True)
        global_ini.write_text("\n".join(lines))
        actions.append(f"enabled obs-websocket (port {wanted['ServerPort']}, password kept in {global_ini})")
    return actions


# --- talking to OBS ----------------------------------------------------------

def record_status(obs):
    rs = obs.request("GetRecordStatus")
    active = rs.get("outputActive", False)
    state = "paused" if rs.get("outputPaused") else "recording" if active else "idle"
    timecode = rs.get("outputTimecode", "")[:8] if active else ""
    return {"state": state, "active": active, "timecode": timecode,
            "bytes": rs.get("outputBytes", 0) if active else 0}


def full_status(obs):
    st = record_status(obs)
    st["scene"] = obs.request("GetCurrentProgramScene").get("currentProgramSceneName", "")
    st["directory"] = obs.request("GetRecordDirectory").get("recordDirectory", "")
    v = obs.request("GetVersion")
    st["obs_version"] = v.get("obsVersion", "")
    st["obs_websocket_version"] = v.get("obsWebSocketVersion", "")
    return st


def scene_names(obs):
    return [s["sceneName"] for s in reversed(obs.request("GetSceneList").get("scenes", []))]


def pipewire_items(obs, scene):
    items = obs.request("GetSceneItemList", {"sceneName": scene}).get("sceneItems", [])
    return [(it["sourceName"], it["sceneItemId"]) for it in items if it.get("inputKind") == PIPEWIRE_KIND]


def capture_live(obs, scene, item_id):
    # A PipeWire source reports 0x0 until the portal stream negotiates its
    # format, i.e. until frames actually flow. Recording before that is black.
    t = obs.request("GetSceneItemTransform", {"sceneName": scene, "sceneItemId": item_id})
    return t.get("sceneItemTransform", {}).get("sourceWidth", 0) > 0


def picker_running():
    # xdg-desktop-portal-wlr's output chooser (slurp by default, wofi/bemenu optional).
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), "slurp|wofi|bemenu"], capture_output=True)
    return r.returncode == 0


def wait_capture(obs, scene, timeout=PICKER_TIMEOUT):
    """Block until every screen capture in `scene` delivers frames.

    Returns True if the portal picker was seen (so the human chose something),
    False if the capture came up by itself (portal restore token)."""
    items = pipewire_items(obs, scene)
    if not items:
        return False
    deadline = time.monotonic() + timeout
    saw_picker, picker_gone_at = False, None
    while True:
        if all(capture_live(obs, scene, item_id) for _, item_id in items):
            return saw_picker
        if picker_running():
            saw_picker, picker_gone_at = True, None
        elif saw_picker:
            picker_gone_at = picker_gone_at or time.monotonic()
            if time.monotonic() - picker_gone_at > 3:
                raise Fail("nothing was selected in the picker; not recording")
        if time.monotonic() > deadline:
            names = ", ".join(n for n, _ in items)
            raise Fail(f"screen capture ({names}) never delivered a frame in {timeout:.0f}s; "
                       "is xdg-desktop-portal-wlr running?")
        time.sleep(0.2)


def repick(obs, scene):
    """Bring the portal picker back for the screen capture(s) in `scene`."""
    items = pipewire_items(obs, scene)
    if not items:
        raise Fail(f"scene {scene!r} has no screen capture to re-pick")
    for name, _ in items:
        # Dropping the restore token makes sure the reload prompts instead of
        # silently restoring the previous selection.
        obs.request("SetInputSettings", {"inputName": name, "inputSettings": {"RestoreToken": ""}, "overlay": True})
        obs.request("PressInputPropertiesButton", {"inputName": name, "propertyName": PIPEWIRE_REPICK_BUTTON})
    deadline = time.monotonic() + 3
    while time.monotonic() < deadline and all(capture_live(obs, scene, i) for _, i in items):
        time.sleep(0.1)  # let the old stream tear down before waiting for the new one
    if not wait_capture(obs, scene):
        warn("the picker did not appear; OBS restored the previous selection")


def launch_obs(scene):
    obs_bin = shutil.which("obs")
    if not obs_bin:
        raise Fail("obs is not installed (sudo apt install obs-studio)")
    for action in ensure_setup():
        info(action)
    args = [obs_bin, "--collection", COLLECTION, "--profile", PROFILE, "--scene", scene,
            "--minimize-to-tray", "--disable-shutdown-check", "--disable-missing-files-check"]
    args += shlex.split(os.environ.get("DIRECTOR_OBS_ARGS", ""))
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = STATE_DIR / "obs.log"
    with open(log, "wb") as out:
        proc = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                cwd=HOME, start_new_session=True)
    deadline = time.monotonic() + LAUNCH_TIMEOUT
    while True:
        try:
            return OBS.connect(timeout=1.0)
        except OBSDown:
            if proc.poll() is not None:
                raise Fail(f"obs exited with status {proc.returncode} during start-up; see {log} "
                           f"and {OBS_DIR / 'logs'}")
            if time.monotonic() > deadline:
                raise Fail(f"obs started (pid {proc.pid}) but obs-websocket never answered; "
                           f"see {OBS_DIR / 'logs'}")
            time.sleep(0.25)


def connect_or_launch(scene):
    """Returns (obs, launched). Launches OBS minimized to the tray when it is down."""
    try:
        return OBS.connect(timeout=1.0), False
    except OBSDown:
        if obs_pids():
            _, port, _ = websocket_config()
            raise Fail(f"OBS is running but obs-websocket is not answering on port {port}; "
                       "enable it (Tools -> WebSocket Server Settings) or quit OBS and rerun "
                       "so `director setup` can")
    info("launching OBS (minimized to the tray)")
    return launch_obs(scene), True


# --- the lock: one start/stop at a time; watch/status read it as "busy" ------

@contextlib.contextmanager
def hold_lock():
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        for attempt in range(5):
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if attempt == 4:
                    raise Fail("busy: another director start/stop is in progress")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)


def lock_held():
    try:
        fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


def busy_state(state):
    return "stopping" if state in ACTIVE_STATES else "starting"


# --- commands ----------------------------------------------------------------

def filename_format(name):
    name = re.sub(r"[^\w.-]+", "-", name or DEFAULT_NAME).strip("-.") or DEFAULT_NAME
    return f"{name}-{TIMESTAMP_FORMAT}"


def do_start(obs, scene, want_repick, name):
    names = scene_names(obs)
    if scene not in names:
        raise Fail(f"unknown scene {scene!r}; have: {', '.join(names)}")
    st = record_status(obs)
    if st["active"]:
        raise Fail(f"already recording ({st['timecode']}); `director stop` first")
    obs.request("SetCurrentProgramScene", {"sceneName": scene})
    picked = wait_capture(obs, scene)
    if want_repick and not picked:
        repick(obs, scene)
    obs.request("SetProfileParameter", {"parameterCategory": "Output", "parameterName": "FilenameFormatting",
                                        "parameterValue": filename_format(name)})
    obs.request("StartRecord")
    deadline = time.monotonic() + RECORD_TIMEOUT
    while not record_status(obs)["active"]:
        if time.monotonic() > deadline:
            raise Fail("StartRecord was accepted but the recording never became active; "
                       f"see {OBS_DIR / 'logs'}")
        time.sleep(0.1)
    return f"recording {scene}"


def newest_recording(obs):
    directory = obs.request("GetRecordDirectory").get("recordDirectory", "")
    files = [p for p in Path(directory).glob("*") if p.is_file()] if directory else []
    return str(max(files, key=lambda p: p.stat().st_mtime)) if files else ""


def do_stop(obs):
    st = record_status(obs)
    if not st["active"]:
        raise Fail("not recording")
    path = obs.request("StopRecord").get("outputPath") or ""
    deadline = time.monotonic() + RECORD_TIMEOUT
    while record_status(obs)["active"]:
        if time.monotonic() > deadline:
            warn("OBS is still finalizing the file")
            break
        time.sleep(0.1)
    return path or newest_recording(obs)


def cmd_start(args):
    scene = args.scene or DEFAULT_SCENE
    with hold_lock():
        obs, _ = connect_or_launch(scene)
        try:
            print(do_start(obs, scene, args.repick, args.name))
        finally:
            obs.close()


def cmd_stop(args):
    with hold_lock():
        obs = OBS.connect()
        try:
            path = do_stop(obs)
        finally:
            obs.close()
    print(f"saved {path}")
    if args.notify:
        notify("Recording saved", path, urgency="normal")


def cmd_toggle(args):
    scene = args.scene or DEFAULT_SCENE
    with hold_lock():
        obs, _ = connect_or_launch(scene)
        try:
            if record_status(obs)["active"]:
                path = do_stop(obs)
                print(f"saved {path}")
                if args.notify:
                    notify("Recording saved", path, urgency="normal")
            else:
                print(do_start(obs, scene, args.repick, args.name))
        finally:
            obs.close()


def cmd_pause(args):
    obs = OBS.connect()
    try:
        if not record_status(obs)["active"]:
            raise Fail("not recording")
        obs.request("ToggleRecordPause")
        time.sleep(0.2)
        print(record_status(obs)["state"])
    finally:
        obs.close()


def cmd_scene(args):
    obs = OBS.connect()
    try:
        names = scene_names(obs)
        if args.scene not in names:
            raise Fail(f"unknown scene {args.scene!r}; have: {', '.join(names)}")
        obs.request("SetCurrentProgramScene", {"sceneName": args.scene})
        print(args.scene)
    finally:
        obs.close()


def cmd_status(args):
    try:
        obs = OBS.connect(timeout=1.0)
    except OBSDown:
        st = {"state": "starting" if lock_held() else "down", "scene": "", "timecode": ""}
    else:
        try:
            st = full_status(obs)
        finally:
            obs.close()
        if lock_held():
            st["state"] = busy_state(st["state"])
    if args.json:
        st.pop("active", None)
        print(json.dumps(st))
    else:
        print(st["state"])


def cmd_scenes(args):
    try:
        obs = OBS.connect(timeout=1.0)
    except OBSDown:
        try:
            saved = json.loads(collection_path().read_text())
        except (OSError, ValueError):
            raise Fail("OBS is not running and there is no saved collection; run `director setup`")
        warn("OBS is not running; listing the saved collection")
        for s in saved.get("scene_order", []):
            print(("* " if s["name"] == saved.get("current_program_scene") else "  ") + s["name"])
        return
    try:
        current = obs.request("GetCurrentProgramScene").get("currentProgramSceneName")
        for name in scene_names(obs):
            print(("* " if name == current else "  ") + name)
    finally:
        obs.close()


def cmd_repick(args):
    with hold_lock():
        obs, launched = connect_or_launch(DEFAULT_SCENE)
        try:
            if record_status(obs)["active"]:
                raise Fail("recording; stop first (the picker would tear down the live capture)")
            scene = obs.request("GetCurrentProgramScene").get("currentProgramSceneName", DEFAULT_SCENE)
            if not pipewire_items(obs, scene):
                scene = DEFAULT_SCENE
            if launched and wait_capture(obs, scene):
                print(f"picked ({scene})")  # the launch picker was the pick
                return
            repick(obs, scene)
            print(f"repicked ({scene})")
        finally:
            obs.close()


def cmd_obs(args):
    with hold_lock():
        obs, launched = connect_or_launch(DEFAULT_SCENE)
        try:
            scene = obs.request("GetCurrentProgramScene").get("currentProgramSceneName", DEFAULT_SCENE)
            wait_capture(obs, scene)
            v = obs.request("GetVersion")
            print(f"obs ready: OBS {v.get('obsVersion')} obs-websocket {v.get('obsWebSocketVersion')}, "
                  f"scene {scene}" + (" (launched)" if launched else ""))
        finally:
            obs.close()


def cmd_quit(args):
    with hold_lock():
        try:
            obs = OBS.connect()
        except OBSDown:
            obs = None
        if obs:
            try:
                if record_status(obs)["active"]:
                    print(f"saved {do_stop(obs)}")
            finally:
                obs.close()
        pids = obs_pids()
        if not pids:
            print("obs is not running")
            return
        for pid in pids:
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, 15)  # OBS shuts down cleanly on SIGTERM (saves its config)
        deadline = time.monotonic() + 20
        while obs_pids():
            if time.monotonic() > deadline:
                raise Fail(f"obs (pid {', '.join(map(str, pids))}) did not exit; a dialog may be open")
            time.sleep(0.2)
        print("obs exited")


def cmd_setup(args):
    actions = ensure_setup(force=args.force)
    for action in actions:
        print(action)
    if not actions:
        print(f"nothing to do: collection {collection_path()}, profile {profile_path()}, "
              "obs-websocket enabled (use --force to rewrite the collection and profile)")


# --- watch: the waybar feed --------------------------------------------------

def short_timecode(tc):
    if not tc:
        return ""
    h, m, s = (tc.split(":") + ["0", "0"])[:3]
    return f"{m}:{s}" if h in ("00", "0", "") else f"{int(h)}:{m}:{s}"


def render_plain(st):
    bits = [st["state"]]
    if st.get("scene"):
        bits.append(st["scene"])
    if st["state"] in ACTIVE_STATES and st.get("timecode"):
        bits.append(st["timecode"])
    return " ".join(bits)


def render_json(st):
    return json.dumps({k: v for k, v in st.items() if k != "active"})


def render_waybar(st):
    """waybar custom-module JSON: `alt` picks the icon (format-icons), `class`
    drives the CSS, `text` is the running timer. Presentation stays in waybar."""
    state, scene = st["state"], st.get("scene") or ""
    classes = [state] + ([re.sub(r"[^a-z0-9_-]+", "-", scene.lower())] if scene else [])
    text = f" {short_timecode(st.get('timecode'))}" if state in ACTIVE_STATES and st.get("timecode") else ""
    tip = [f"{PROG}: {state}" + (f" ({scene})" if scene else "")]
    if state in ACTIVE_STATES:
        tip.append(f"{st.get('timecode', '')} · {st.get('bytes', 0) / 1e6:.1f} MB · {st.get('directory', '')}")
    elif state == "idle":
        if st.get("last_path"):
            tip.append(f"last: {st['last_path']}")
        tip.append("left: record screen · right: record pip · middle: pause")
    elif state == "down":
        tip.append("OBS is not running; click or $mod+Ctrl+r launches it and records")
    elif state == "starting":
        tip.append("launching OBS / waiting for the capture (the output picker, if it shows, wants a click)")
    if st.get("obs_version"):
        tip.append(f"OBS {st['obs_version']} · obs-websocket {st.get('obs_websocket_version', '')}")
    return json.dumps({"text": text, "alt": state, "class": classes, "tooltip": "\n".join(tip)})


RENDERERS = {"plain": render_plain, "json": render_json, "waybar": render_waybar}


def cmd_watch(args):
    render = RENDERERS[args.format]
    last = None

    def emit(st):
        nonlocal last
        line = render(st)
        if line == last:
            return
        last = line
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except BrokenPipeError:
            raise SystemExit(0)

    last_path = ""
    while True:
        try:
            obs = OBS.connect(events=EV_GENERAL | EV_SCENES | EV_OUTPUTS, timeout=1.0)
        except Fail:
            emit({"state": "starting" if lock_held() else "down", "scene": "", "timecode": ""})
            time.sleep(0.5 if lock_held() else 2.0)  # poll fast only while a launch is under way
            continue
        try:
            last_path = watch_connected(obs, emit, last_path)
        except (OSError, ConnectionError, Fail, ValueError):
            pass
        finally:
            obs.close()


def watch_connected(obs, emit, last_path):
    st = full_status(obs)
    st["last_path"] = last_path
    # The lock marks the gaps OBS does not know about: the launch and the wait
    # for the capture before StartRecord, the file finalization after StopRecord.
    # Which way we are going is latched from the state when the lock was first
    # seen held, so the overlay never flips direction mid-transition.
    busy_from = None
    while True:
        held = lock_held()
        if not held:
            busy_from = None
        elif busy_from is None:
            busy_from = st["state"]
        shown = dict(st)
        if held and busy_from in STOP_DIRECTION and st["state"] in ACTIVE_STATES:
            shown["state"] = "stopping"
        elif held and busy_from not in STOP_DIRECTION and st["state"] == "idle":
            shown["state"] = "starting"
        emit(shown)
        ev = obs.next_event(timeout=1.0)
        if ev is None:
            if st["active"]:
                st.update(record_status(obs))
            continue
        kind, data = ev
        if kind == "RecordStateChanged":
            st.update(record_status(obs))
            mapped = OUTPUT_STATES.get(data.get("outputState"))
            if mapped:
                st["state"] = mapped
            if data.get("outputPath"):
                st["last_path"] = last_path = data["outputPath"]
        elif kind == "CurrentProgramSceneChanged":
            st["scene"] = data.get("sceneName", st["scene"])
        elif kind == "ExitStarted":
            return last_path


OUTPUT_STATES = {
    "OBS_WEBSOCKET_OUTPUT_STARTING": "starting",
    "OBS_WEBSOCKET_OUTPUT_STARTED": "recording",
    "OBS_WEBSOCKET_OUTPUT_PAUSED": "paused",
    "OBS_WEBSOCKET_OUTPUT_RESUMED": "recording",
    "OBS_WEBSOCKET_OUTPUT_STOPPING": "stopping",
    "OBS_WEBSOCKET_OUTPUT_STOPPED": "idle",
}
STOP_DIRECTION = ACTIVE_STATES + ("stopping",)


# --- plumbing ----------------------------------------------------------------

def info(msg):
    print(f"{PROG}: {msg}", file=sys.stderr)


def warn(msg):
    print(f"{PROG}: warning: {msg}", file=sys.stderr)


def notify(summary, body, urgency="critical"):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", PROG, "-u", urgency, summary, body], check=False)


def build_parser():
    p = argparse.ArgumentParser(prog=PROG, add_help=False, usage=argparse.SUPPRESS)
    p.add_argument("--notify", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    sub = p.add_subparsers(dest="command")
    for name in ("start", "toggle"):
        s = sub.add_parser(name, add_help=False)
        s.add_argument("--repick", action="store_true")
        s.add_argument("--name")
        s.add_argument("scene", nargs="?")
    sub.add_parser("stop", add_help=False)
    sub.add_parser("pause", add_help=False)
    s = sub.add_parser("scene", add_help=False)
    s.add_argument("scene")
    s = sub.add_parser("status", add_help=False)
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("watch", add_help=False)
    s.add_argument("--format", choices=sorted(RENDERERS), default="plain")
    sub.add_parser("scenes", add_help=False)
    sub.add_parser("repick", add_help=False)
    sub.add_parser("obs", add_help=False)
    sub.add_parser("quit", add_help=False)
    s = sub.add_parser("setup", add_help=False)
    s.add_argument("--force", action="store_true")
    sub.add_parser("help", add_help=False)
    return p


COMMANDS = {
    "start": cmd_start, "toggle": cmd_toggle, "stop": cmd_stop, "pause": cmd_pause, "scene": cmd_scene,
    "status": cmd_status, "watch": cmd_watch, "scenes": cmd_scenes, "repick": cmd_repick,
    "obs": cmd_obs, "quit": cmd_quit, "setup": cmd_setup,
}


def main(argv):
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        print(USAGE, file=sys.stderr, end="")
        return 2
    if args.help or args.command == "help":
        print(USAGE, end="")
        return 0
    if args.command is None:
        print(USAGE, file=sys.stderr, end="")
        return 2
    try:
        COMMANDS[args.command](args)
    except KeyboardInterrupt:
        return 130
    except Fail as e:
        print(f"{PROG}: {e}", file=sys.stderr)
        if args.notify:
            notify(PROG, str(e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
